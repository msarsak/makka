# ============================================================
#  HEPHAESTION – Einstellungen
#  1. Kopiere diese Datei und nenne die Kopie ".env"
#  2. Trage deine Werte ein. Die .env wird NIE hochgeladen.
# ============================================================

# Claude API-Key von https://console.anthropic.com  (beginnt mit sk-ant-)
# Leer lassen = Demo-Modus (Hephaestion antwortet mit Platzhalter-Texten)
ANTHROPIC_API_KEY=

# Modelle: schnell & günstig für den Alltag, stark für schwere Aufgaben
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-opus-5-5

# Stadt für die Wetteranzeige (falls der Browser keinen Standort freigibt)
WEATHER_CITY=Berlin

# Port, auf dem Hephaestion läuft
PORT=3000
