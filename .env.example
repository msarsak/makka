# ============================================================
#  HEPHAESTION – Einstellungen
#  1. Kopiere diese Datei und nenne die Kopie ".env"
#  2. Trage deine Werte ein. Die .env wird NIE hochgeladen.
# ============================================================

# Claude API-Key von https://console.anthropic.com  (beginnt mit sk-ant-)
# Leer lassen = Demo-Modus (Hephaestion antwortet mit Platzhalter-Texten)
ANTHROPIC_API_KEY=

# Modelle: schnell & günstig für den Alltag, stark für schwere Aufgaben
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-opus-5-5

# Stadt für die Wetteranzeige (falls der Browser keinen Standort freigibt)
WEATHER_CITY=Berlin

# Gedächtnis: Pfad zu deinem Obsidian-Vault (ohne Anführungszeichen), z. B.
# OBSIDIAN_VAULT=C:\Users\DeinName\Documents\Obsidian\MeinVault
# Leer lassen = Hephaestion legt im Projektordner einen eigenen Vault "vault" an.
# Er schreibt NUR in den Unterordner "Hephaestion" und löscht nie etwas.
OBSIDIAN_VAULT=

# Optional: eigene Notizen, die er vor JEDEM Gespräch liest (Pfade im Vault, mit Komma getrennt)
# OBSIDIAN_CORE_NOTES=Über mich.md,Projekte/Mein Business.md
OBSIDIAN_CORE_NOTES=

# Google Maps API-Key für Street View (Maps Embed API + Street View Static API)
# Leer lassen = Street View öffnet sich nur als Link zu Google Maps.
GOOGLE_MAPS_API_KEY=

# Port, auf dem Hephaestion läuft
PORT=3000
