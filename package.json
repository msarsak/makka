{
  "name": "hephaestion",
  "version": "0.1.0",
  "private": true,
  "description": "Hephaestion – persönlicher KI-Assistent mit Hologramm-HUD",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,red \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "check-key": "node server/check-key.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "dotenv": "^18.0.9",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.6"
  }
}
